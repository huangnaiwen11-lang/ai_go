{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cling 主站业务语义案例",
  "description": "用于冻结 Go 重构前后必须保持一致的脱敏业务事实。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["case_id", "consumer", "actor", "template", "fixture", "expected", "source"],
    "properties": {
      "case_id": {"type": "string", "minLength": 1},
      "consumer": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path"],
        "properties": {
          "method": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^/"}
        }
      },
      "actor": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account_status", "binding_state"],
        "properties": {
          "account_status": {"enum": ["normal", "banned", "deleted"]},
          "binding_state": {"enum": ["guest", "bound"]},
          "reviewed": {"type": "boolean"},
          "user_timezone": {"type": "string"}
        }
      },
      "template": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "content_surface", "product_mode"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "content_surface": {"type": "string", "minLength": 1},
          "product_mode": {"type": "string", "minLength": 1}
        }
      },
      "fixture": {"type": "object"},
      "expected": {
        "type": "object",
        "additionalProperties": false,
        "required": ["http", "database_before", "database_after", "side_effects", "technical_calls"],
        "properties": {
          "http": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "error_code"],
            "properties": {
              "status": {"type": "integer", "minimum": 100, "maximum": 599},
              "error_code": {"type": "string"}
            }
          },
          "database_before": {"type": "object", "minProperties": 1},
          "database_after": {"type": "object", "minProperties": 1},
          "side_effects": {"type": "array", "items": {"type": "string"}},
          "technical_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["atom", "callback_purpose", "protocol_version", "idempotency_key"],
              "properties": {
                "atom": {"enum": ["text_to_image", "image_edit", "image_to_video"]},
                "callback_purpose": {"type": "string", "minLength": 1},
                "protocol_version": {"type": "string", "minLength": 1},
                "idempotency_key": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["confirmed_business_baseline", "isolated_local_node_observation"]}
        }
      }
    }
  }
}
